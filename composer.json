{
  "name": "mecxer713/wialon-package",
  "description": "SDK Laravel pour l'API Wialon (Gurtam) : authentification automatique, façade, appels simplifiés et gestion SSL locale.",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Mecxer\\WialonPackage\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Mecxer\\WialonPackage\\Tests\\": "src/tests/"
    }
  },
  "authors": [
    {
      "name": "Mecxer713",
      "email": "Mecxer@gmail.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "guzzlehttp/guzzle": "^7.8",
    "illuminate/support": "^10.0|^11.0|^12.0",
    "illuminate/console": "^10.0|^11.0|^12.0",
    "illuminate/filesystem": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "orchestra/testbench": "^8.0|^9.0"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Mecxer\\WialonPackage\\WialonServiceProvider"
      ],
      "aliases": {
        "Wialon": "Mecxer\\WialonPackage\\Facades\\Wialon"
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}

