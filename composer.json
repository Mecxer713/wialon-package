{
  "name": "mecxer713/wialon-package",
  "description": "Laravel and Symfony SDK for the Wialon (Gurtam) API: auto authentication, facade, simplified calls, and local SSL handling.",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Mecxer\\WialonPackage\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Mecxer\\WialonPackage\\Tests\\": "src/tests/"
    }
  },
  "authors": [
    {
      "name": "Mecxer713",
      "email": "Mecxer@gmail.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "guzzlehttp/guzzle": "^7.8",
    "illuminate/support": "^10.0|^11.0|^12.0",
    "illuminate/console": "^10.0|^11.0|^12.0",
    "illuminate/filesystem": "*",
    "symfony/config": "^7.4",
    "symfony/dependency-injection": "^7.4",
    "symfony/http-kernel": "^7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "orchestra/testbench": "^8.0|^9.0"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Mecxer\\WialonPackage\\WialonServiceProvider"
      ],
      "aliases": {
        "Wialon": "Mecxer\\WialonPackage\\Facades\\Wialon"
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
